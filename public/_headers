# Cloudflare serves a matching static asset *before* the Worker runs, so the
# hardening in src/lib/response.js never sees these requests. This file is how
# the asset server gets the same policy.
#
# Keep it in step with PAGE_CSP and SECURITY_HEADERS in src/config/constants.js
# — the Worker still hardens asset responses it proxies itself, so the two paths
# should agree.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'

# Pages are marked no-transform so Cloudflare does not rewrite them. Its Web
# Analytics beacon was being injected into every page despite being switched
# off in the dashboard; script-src 'self' blocked it, so it collected nothing,
# but its presence made /privacy's "no third-party scripts" untrue. Listed by
# path rather than /* so the CSS and JS rules below are not joined with these.
# max-age=0 is the asset server's own default for HTML, kept as it was.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/createMockServer
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/openapiMockServer
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/uiPlayground
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacy
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/docs/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/dashboard
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/insights
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# CSS and JS are referenced from the HTML as /name.css?v=<content hash>, written
# by scripts/stamp-assets.mjs, so a changed file always arrives at a new URL and
# the old one can be kept for a year. HTML is not listed: it keeps the default
# max-age=0, which is what keeps the stamps current.
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
