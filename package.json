{
  "name": "flaky",
  "version": "0.1.0",
  "description": "A mock REST API that fails on purpose — control status, latency and failure rate per request.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm test && wrangler deploy",
    "seed": "node scripts/generate-db.js",
    "test": "npm run check:public && npm run check:docs && npm run check:tables && npm run check:stamps && node --test \"tests/**/*.test.mjs\"",
    "check:public": "node scripts/check-public.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:tables": "node scripts/bake-tables.mjs --check",
    "check:stamps": "node scripts/stamp-assets.mjs --check",
    "stamp": "node scripts/stamp-assets.mjs",
    "bake:tables": "node scripts/bake-tables.mjs",
    "check:render": "node scripts/check-render.mjs",
    "check:runners": "node scripts/check-runners.mjs",
    "db:migrate": "wrangler d1 migrations apply flaky --remote",
    "db:migrate:local": "wrangler d1 migrations apply flaky --local",
    "tail": "wrangler tail",
    "e2e": "bash scripts/e2e.sh"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
